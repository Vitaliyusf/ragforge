# Node / frontend
node_modules/
.next/
dist/
coverage/

# Python
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
*.egg-info/

# Task-local tool caches. These belong under .agent-private/tooling/<task-id>/,
# but variants such as .uv-cache-safe01-memory have escaped to the repo root
# before; match the family, not one exact name.
.uv-cache*/
.uv-python*/
.pytest-tmp*/
.ruff-cache*/

# Env and secrets
.env
.env.*
!.env.example
.envrc
*.pem
*.key
*.crt
*.p12
id_rsa*
*.pfx

# Logs and runtime data
logs/
# ...but `logs/` is unanchored, so it also matched the Logs *feature* source
# at frontend/src/features/logs/, which was silently never committed.
!frontend/src/features/logs/
*.log
uploads/
qdrant_storage/

# Build output and caches
*.whl
*.tar.gz
.cache/
.parcel-cache/

# OS/editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~

# Coverage
.coverage
coverage.xml
htmlcov/

# Docker runtime
*.pid

# Claude / agent tooling
# AI Brain generated/private state. `docs/ai` itself is repository source:
# the canonical runtime contract and the public task specs must be reproducible
# from Git, not local shadow state. Only generated indexes and private agent
# memory stay out.
/docs/ai/generated/*.json
/.agent-private/
*.zip

# RAGForge agent brain

# Shared Claude project context: track root adapter + path-scoped rules
/.claude/*
!/.claude/rules/
!/.claude/rules/**
/CLAUDE.local.md
# Legacy nested Claude adapters are intentionally retired; .claude/rules owns path scoping.
/backend/CLAUDE.md
/backend/rag/CLAUDE.md
/frontend/CLAUDE.md

# Shared Claude enforcement hooks
!/.claude/settings.json
!/.claude/hooks/
!/.claude/hooks/**

# ...but never the Python build caches the hook runtime leaves behind.
/.claude/hooks/**/__pycache__
/.claude/hooks/**/*.pyc
