# Node / frontend
node_modules/
.next/
dist/
coverage/

# Python
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
*.egg-info/

# Task-local tool caches. These belong under .agent-private/tooling/<task-id>/,
# but variants such as .uv-cache-safe01-memory have escaped to the repo root
# before; match the family, not one exact name.
.uv-cache*/
.uv-python*/
.pytest-tmp*/
.ruff-cache*/

# Env and secrets
.env
.env.*
!.env.example
.envrc
*.pem
*.key
*.crt
*.p12
id_rsa*
*.pfx

# Logs and runtime data
logs/
# ...but `logs/` is unanchored, so it also matched the Logs *feature* source
# at frontend/src/features/logs/, which was silently never committed.
!frontend/src/features/logs/
*.log
uploads/
qdrant_storage/

# Build output and caches
*.whl
*.tar.gz
.cache/
.parcel-cache/

