{
  "permissions": {
    "defaultMode": "default",
    "allow": [
      "Bash(git status)",
      "Bash(git status --short)",
      "Bash(git branch --show-current)",
      "Bash(git rev-parse HEAD)",
      "Bash(git log -1 --oneline)",
      "Bash(git diff --stat)",
      "Bash(git diff --check)",
      "Bash(git diff --cached --stat)",
      "Bash(git diff --cached --check)"
    ],
    "deny": [
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git reset:*)",
      "Bash(git clean:*)",
      "Bash(git stash:*)",
      "Bash(git rebase:*)",
      "Bash(git merge:*)",
      "Bash(git cherry-pick:*)",
      "Bash(git checkout:*)",
      "Bash(git switch:*)",
      "Bash(git branch -D:*)",
      "Bash(git branch -d:*)",
      "Bash(rm -rf:*)",
      "Bash(sudo:*)",
      "Bash(chmod 777:*)"
    ]
  },
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Glob|Grep|Edit|Write|Bash|PowerShell|Agent",
        "hooks": [
          {
            "type": "command",
            "command": "py",
            "args": [
              "-3.12",
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/repo-bootstrap.py",
              "pre"
            ],
            "timeout": 3
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Read|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "py",
            "args": [
              "-3.12",
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/repo-bootstrap.py",
              "post"
            ],
            "timeout": 3
          }
        ]
      }
    ]
  }
}
