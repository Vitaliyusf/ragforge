# Normalize every text file to LF inside the repository, so the stored content
# is identical regardless of a contributor's platform or core.autocrlf setting.
* text=auto eol=lf

# These are executed inside Linux containers, where a CRLF shebang or
# instruction line fails at runtime rather than at build time.
*.sh        text eol=lf
Dockerfile  text eol=lf
Caddyfile   text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf

# Windows-only tooling; keep it native on the platform that runs it.
*.ps1       text eol=crlf

# Generated dependency graph: keep it out of diffs and out of the repository's
# language statistics, where 230 KB of JSON would otherwise dominate.
package-lock.json  -diff linguist-generated
