# Docker / Compose
DOCKER_BUILDKIT=1
COMPOSE_DOCKER_CLI_BUILD=1
COMPOSE_PROJECT_NAME=ragforge

# Only frontend, gateway and RAG bind to host loopback in development.
PUBLIC_FRONTEND_PORT=3000
PUBLIC_GATEWAY_PORT=8000
PUBLIC_LLM_AGENT_PORT=8001
PUBLIC_EMBEDDING_PORT=8002
PUBLIC_RAG_PORT=8004
PUBLIC_FILES_PORT=8005
PUBLIC_VECTOR_DB_PORT=8006
PUBLIC_MEMORY_PORT=8007
PUBLIC_VLLM_PORT=8008
PUBLIC_ZOOKEEPER_PORT=2181
PUBLIC_KAFKA_PORT=9092
PUBLIC_MONGODB_PORT=27017
PUBLIC_QDRANT_HTTP_PORT=6333
PUBLIC_QDRANT_GRPC_PORT=6334

# Public URLs compiled into the frontend and used for CORS
FRONTEND_PUBLIC_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_RAG_WS_URL=http://localhost:8004
NEXT_PUBLIC_VLLM_BASE_URL=http://localhost:8008
NEXT_PUBLIC_TRAINING_API_BASE_URL=http://localhost:8009/v1/training
NEXT_PUBLIC_ENABLE_TRAINING_TAB=false

# Container images
MONGODB_IMAGE=mongo:7
ZOOKEEPER_IMAGE=zookeeper:3.9
KAFKA_IMAGE=confluentinc/cp-kafka:7.5.0
QDRANT_IMAGE=qdrant/qdrant:v1.18.2-unprivileged
VLLM_IMAGE=vllm/vllm-openai:v0.27.1

# Immutable benchmark build provenance. Release/build automation should stamp
# these before building the RAG image; leave blank rather than guessing.
RAGFORGE_GIT_SHA=
RAGFORGE_GIT_BRANCH=
RAGFORGE_GIT_DIRTY=
# Required when RAGFORGE_GIT_DIRTY=true; generated by
# scripts/build_rag_image.py, never from a raw diff or environment dump.
RAGFORGE_SOURCE_FINGERPRINT_SHA256=
RAGFORGE_BUILD_TIMESTAMP=
RAGFORGE_IMAGE_TAG=

# Optional secret used only for gated model downloads
HF_TOKEN=

# vLLM serving configuration
VLLM_MODEL=RedHatAI/Qwen3.5-4B-quantized.w4a16
VLLM_QUANTIZATION=compressed-tensors
VLLM_GPU_MEMORY_UTILIZATION=0.85
VLLM_MAX_MODEL_LEN=10240
VLLM_MAX_NUM_SEQS=4
VLLM_MAX_NUM_BATCHED_TOKENS=2048
VLLM_PERFORMANCE_MODE=interactivity
VLLM_MAX_TOKENS=512
VLLM_API_KEY=replace-with-a-random-vllm-api-key
# The V1 runner is the accepted runtime for this deployment.
VLLM_USE_V2_MODEL_RUNNER=0

# llm_agent runtime configuration
LLM_IMPLEMENTATION=vllm
# Bounded primary typed-LLM queue prefetch; benchmark supported values 1, 2, and 4.
LLM_REQUEST_PREFETCH=4
ANSWER_GENERATION_MAX_TOKENS=128
ANSWER_EVALUATION_MAX_TOKENS=512
# Accepted answer-evaluation transport. Runtime settings are deployment-owned;
# changing this file requires recreating/restarting llm_agent to take effect.
ANSWER_EVALUATION_STRUCTURED_OUTPUT_TRANSPORT=json_schema
# Judge-contract provenance recorded in the benchmark manifest. Both are
# llm_agent facts that rag cannot see from its own process, so deployment
# injects them; leaving either empty records it as unknown, and a benchmark
# comparison across it reports "unknown" rather than assuming a match.
# Generate the digest, never type it:
#   python scripts/answer_review_schema_sha.py --env
ANSWER_EVALUATION_OUTPUT_SCHEMA_SHA256=
# The prompt version llm_agent's registry actually resolves for
# answer_evaluation (currently answer_evaluation.v2).
ANSWER_EVALUATION_PROMPT_VERSION=
# Populate only from a successful runtime /version probe; never infer from VLLM_IMAGE.
VLLM_OBSERVED_SERVER_VERSION=
CONTENT_RISK_SCAN_MAX_TOKENS=128
QUERY_REWRITE_MAX_TOKENS=128
MEMORY_EXTRACTION_MAX_TOKENS=512
SUMMARY_MODEL=RedHatAI/Qwen3.5-4B-quantized.w4a16
METADATA_MODEL=RedHatAI/Qwen3.5-4B-quantized.w4a16
RAG_CHAT_MODEL=RedHatAI/Qwen3.5-4B-quantized.w4a16
DEFAULT_MODEL=RedHatAI/Qwen3.5-4B-quantized.w4a16
MAX_CONCURRENT_REQUESTS=4
PROVIDER_ADMISSION_TIMEOUT_SECONDS=1
VLLM_CONNECT_TIMEOUT=5
VLLM_READ_TIMEOUT=60
VLLM_WRITE_TIMEOUT=10
VLLM_POOL_TIMEOUT=1
VLLM_KEEPALIVE_EXPIRY=30
LLM_TIMEOUT=60
SUMMARY_TIMEOUT=120
METADATA_TIMEOUT=60

# Retrieval / memory tuning
EMBEDDING_MODEL=intfloat/multilingual-e5-small
# Bounds any runtime huggingface fetch so a stalled download cannot hang startup.
# The model is baked into the embedding image at build time; changing EMBEDDING_MODEL
# requires `docker compose build embedding` to re-bake it.
HF_HUB_DOWNLOAD_TIMEOUT=30
VECTOR_DB_COLLECTION_NAME=vectors
VECTOR_DB_VECTOR_SIZE=384
VECTOR_STORE_TYPE=qdrant
CHUNK_SIZE=1200
CHUNK_OVERLAP=200
METADATA_FETCH_TIMEOUT=5.0
RERANKER_ENABLED=true
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_MODEL_REVISION=b5160aeac3c6c8fe7beaaaf04c9e0142826b58d1
RERANKER_CANDIDATE_K=8
RERANKER_TIMEOUT_SECONDS=12.0
RERANKER_BATCH_SIZE=8
RERANKER_MAX_LENGTH=512
# Bounded cross-request rerank scheduling (CONC-05). The window is the only
# latency batching can add, and it is zero by default: the scheduler combines
# whatever is already queued when a worker frees up, but never makes a request
# wait for company. The outstanding bound is the measured live admission
# envelope; the pending bound independently caps queue storage/backpressure.
RERANKER_MICROBATCH_WINDOW_MS=0
RERANKER_MAX_BATCH_PAIRS=8
RERANKER_MAX_OUTSTANDING_PAIRS=32
RERANKER_MAX_PENDING_PAIRS=40
RERANKER_ADMISSION_TIMEOUT_SECONDS=0.5
RERANKER_INFERENCE_WORKERS=2
RERANKER_MAX_BACKGROUND_INFLIGHT=1
# Chunks fed into the answer prompt after learned reranking.
TOP_K_DOCUMENTS=6
HYBRID_SEARCH_ENABLED=true
DENSE_CANDIDATE_K=20
SPARSE_CANDIDATE_K=20
HYBRID_RRF_K=60
CONVERSATION_STORE_TYPE=mongodb
MEMORY_QDRANT_ENABLED=true
MEMORY_REPLICAS=1
QDRANT_API_KEY=replace-with-a-random-secret-at-least-32-characters
QDRANT_HTTPS=false
RAG_INTERNAL_REQUEST_TIMEOUT=75
RAG_GENERATION_REQUEST_TIMEOUT=120
RAG_EVALUATION_REQUEST_TIMEOUT=75

# Gateway timeouts
GATEWAY_DEFAULT_TIMEOUT=120
GATEWAY_SHORT_TIMEOUT=30

# Admin metrics — Prometheus is internal infrastructure on the `messaging`
# network and is not published to the host. The gateway reads it by name.
PROMETHEUS_URL=http://prometheus:9090

# RabbitMQ
RABBITMQ_URL=amqp://ragapp:replace-me@rabbitmq:5672/
RABBITMQ_USER=ragapp
RABBITMQ_PASSWORD=replace-with-a-random-secret-at-least-24-characters
PUBLIC_RABBITMQ_PORT=5672
PUBLIC_RABBITMQ_MGMT_PORT=15672

# Kafka is used only by the durable document-ingestion pipeline
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
FILES_PIPELINE_TOPIC=files.requests
KAFKA_PIPELINE_PARTITIONS=4
KAFKA_PIPELINE_CONSUMER_WORKERS=4
EMBEDDING_JOBS_REQUESTED_TOPIC=embedding.jobs.requested
VECTOR_DB_UPSERT_REQUESTED_TOPIC=vector_db.upsert.requested
EMBEDDING_JOBS_COMPLETED_TOPIC=embedding.jobs.completed
# Authentication is mandatory. Generate every value independently; never commit real values.
AUTH_REQUIRED=true
INTERNAL_AUTH_SECRET=replace-with-at-least-32-random-bytes
BOOTSTRAP_TENANT_ID=default
BOOTSTRAP_TENANT_NAME=Default Workspace
# Leave both empty to create the first administrator interactively in the browser
# on first run. Set them only for non-interactive (scripted) deployments.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
PASSWORD_PEPPER=replace-with-at-least-32-random-bytes
SESSION_PEPPER=replace-with-at-least-32-random-bytes
SESSION_COOKIE_SECURE=false
TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128

# MongoDB root is used only for initialization; each service has its own application user.
MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=replace-with-a-random-secret-at-least-24-characters
MONGO_GATEWAY_PASSWORD=replace-with-a-random-url-safe-secret
MONGO_FILES_PASSWORD=replace-with-a-random-url-safe-secret
MONGO_MEMORY_PASSWORD=replace-with-a-random-url-safe-secret
MONGO_RAG_PASSWORD=replace-with-a-random-url-safe-secret

# File upload limits
MAX_UPLOAD_BYTES=26214400

# Production TLS entrypoint (used with docker-compose.prod.yml)
APP_ENV=development
APP_DOMAIN=app.example.com
