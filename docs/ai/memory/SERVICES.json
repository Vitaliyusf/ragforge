{
  "schema_version": 1,
  "services": [
    {
      "id": "gateway",
      "path": "backend/gateway",
      "entrypoint": "backend/gateway/app/main.py",
      "responsibilities": [
        "browser-facing REST",
        "auth/session façade",
        "service RPC façade",
        "admin metrics/eval API"
      ],
      "owns": [
        "client-facing authorization boundary",
        "REST adaptation"
      ],
      "calls": [
        "rag",
        "files",
        "memory",
        "embedding",
        "vector_db",
        "llm_agent",
        "prometheus"
      ],
      "transports": [
        "HTTP from frontend",
        "RabbitMQ RPC to backend services"
      ],
      "look_first": [
        "backend/gateway/app/core/deps.py",
        "backend/gateway/app/services",
        "backend/gateway/app/rest"
      ],
      "avoid_duplicate": "Frontend should normally use Gateway rather than call internal services directly."
    },
    {
      "id": "rag",
      "path": "backend/rag",
      "entrypoint": "backend/rag/app/main.py",
      "responsibilities": [
        "Regular/Extended RAG",
        "retrieval orchestration",
        "generation/evaluation",
        "conversation checkpoints",
        "golden-set eval",
        "RAG metrics facts"
      ],
      "owns": [
        "RAG pipeline semantics",
        "context selection",
        "eval orchestration",
        "RAG trace events"
      ],
      "calls": [
        "embedding",
        "vector_db",
        "memory",
        "llm_agent"
      ],
      "transports": [
        "RabbitMQ/service RPC",
        "streaming response path"
      ],
      "look_first": [
        "backend/rag/app/services/conversation_graph.py",
        "backend/rag/app/services/conversation_backend_client.py",
        "backend/rag/app/services/eval_runner.py",
        "backend/rag/app/services/eval_store.py"
      ],
      "avoid_duplicate": "Extend RAG's graph/eval/trace; do not recreate retrieval/eval logic in Gateway/frontend."
    },
    {
      "id": "files",
      "path": "backend/files",
      "entrypoint": "backend/files/app/main.py",
      "responsibilities": [
        "file lifecycle",
        "ingestion state",
        "review/audit",
        "file/chunk metadata"
      ],
      "owns": [
        "file ownership/state",
        "ingestion workflow truth"
      ],
      "calls": [
        "embedding",
        "vector_db"
      ],
      "transports": [
        "RabbitMQ RPC",
        "Kafka ingestion/events"
      ],
      "look_first": [
        "backend/files/app/services/file_service.py",
        "backend/files/app/services/file_ingestion_graph.py",
        "backend/files/app/db"
      ],
      "avoid_duplicate": "File metadata/lifecycle truth belongs in Files."
    },
    {
      "id": "embedding",
      "path": "backend/embedding",
      "entrypoint": "backend/embedding/app/main.py",
      "responsibilities": [
        "query embedding over RabbitMQ",
        "typed passage embedding jobs",
        "temporary document extraction bridge for Files"
      ],
      "owns": [
        "embedding model execution",
        "extractor implementations"
      ],
      "calls": [
        "vector_db typed upserts",
        "files ingestion completion",
        "llm_agent summary and metadata queues"
      ],
      "transports": [
        "RabbitMQ query request/reply",
        "Kafka embedding.jobs.requested passage jobs",
        "Kafka embedding.requests extraction commands"
      ],
      "look_first": [
        "backend/embedding/app/services/embedding_job_service.py",
        "backend/embedding/app/services/embedding_handler.py",
        "backend/embedding/app/embedding",
        "backend/embedding/app/extraction"
      ],
      "avoid_duplicate": "Queries use the RabbitMQ query handler; passages use typed embedding jobs. Do not add another Kafka embedding request path or load embedding models in unrelated services."
    },
    {
      "id": "vector_db",
      "path": "backend/vector_db",
      "entrypoint": "backend/vector_db/app/main.py",
      "responsibilities": [
        "dense+sparse hybrid vector search and deterministic fusion",
        "upsert/delete/count",
        "Qdrant tenant/filter enforcement"
      ],
      "owns": [
        "Qdrant access",
        "vector-store abstraction"
      ],
      "calls": [],
      "transports": [
        "RabbitMQ RPC",
        "Kafka workflow where configured"
      ],
      "look_first": [
        "backend/vector_db/app/services/vector_service.py",
        "backend/vector_db/app/db/interfaces.py",
        "backend/vector_db/app/db/implementations/qdrant.py"
      ],
      "avoid_duplicate": "Do not bypass the Vector service with new direct Qdrant clients or post-hoc lexical bonuses. Extend the canonical dense+sparse arms and shared filters."
    },
    {
      "id": "memory",
      "path": "backend/memory",
      "entrypoint": "backend/memory/app/main.py",
      "responsibilities": [
        "chat-history projection",
        "long-term memory",
        "typed memory curation orchestration"
      ],
      "owns": [
        "memory records",
        "memory mutation semantics",
        "validated memory mutation application",
        "bounded Memory Agent policy, retries and safe fallback",
        "memory lifecycle state (active/superseded/archived/deleted)",
        "memory vector synchronization state",
        "deterministic memory consolidation and temporal conflict policy",
        "bounded canonical-memory/vector-index reconciliation"
      ],
      "calls": [
        "llm_agent typed title/summary/curation requests",
        "embedding service query/passage vectors for memory retrieval"
      ],
      "transports": [
        "RabbitMQ RPC",
        "events/projections where configured"
      ],
      "look_first": [
        "backend/memory/app/agent/memory_agent.py",
        "backend/memory/app/services/memory_service.py",
        "backend/memory/app/services/memory_embedding_client.py",
        "backend/memory/app/services/memory_vector_index.py",
        "backend/memory/app/services/memory_consolidation.py",
        "backend/memory/app/services/memory_reconciliation.py",
        "backend/memory/app/services/chat_exit_service.py",
        "backend/memory/app/db"
      ],
      "avoid_duplicate": "Long-term memory belongs here; RAG should query/call Memory rather than create another store."
    },
    {
      "id": "llm_agent",
      "path": "backend/llm_agent",
      "entrypoint": "backend/llm_agent/app/main.py",
      "responsibilities": [
        "typed LLM generation/evaluation control plane",
        "vLLM provider integration",
        "process-wide fair vLLM admission and reusable HTTP transport"
      ],
      "owns": [
        "canonical typed model execution boundary",
        "prompt rendering, invocation, decoding, validation, and telemetry policy",
        "one shared provider capacity budget across live, eval, summary, metadata, memory, rewrite, risk, and generated-question work"
      ],
      "calls": [
        "vLLM model backend"
      ],
      "transports": [
        "RabbitMQ RPC",
        "HTTP/model backend"
      ],
      "look_first": [
        "backend/llm_agent/app/llm",
        "backend/llm_agent/app/core",
        "backend/llm_agent/app/services"
      ],
      "avoid_duplicate": "All service-owned model calls must use typed llm_agent requests; do not add direct provider clients."
    }
  ]
}
